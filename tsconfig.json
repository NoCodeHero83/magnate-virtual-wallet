{

  "extends": "expo/tsconfig.base",

  "compilerOptions": {

    "strict": true,

    "experimentalDecorators": true,

    "emitDecoratorMetadata": true,

    "strictPropertyInitialization": false,

    "baseUrl": ".",

    "paths": {

      "@/*": [

        "./*"

      ]

    },

    "types": [

      "reflect-metadata"

    ]

  },

  "include": [

    "**/*.ts",

    "**/*.tsx"

  ],

  "exclude": [

    "node_modules",

    "babel.config.js",

    "metro.config.js",

    "App.tsx",

    "supabase/functions"

  ]

}